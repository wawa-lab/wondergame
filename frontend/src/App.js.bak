import React, {useCallback, useEffect, useRef, useState} from 'react';
import axios from 'axios';
import CharacterPanel from './components/CharacterPanel';
import SceneView from './components/SceneView';
import WardrobePanel from './components/WardrobePanel';
import SkillsPanel from './components/SkillsPanel';
import ActivityLog from './components/ActivityLog';
import Toast from './components/Toast';
import LoadingScreen from './components/LoadingScreen';
import TopBar from './components/TopBar';
import NavigationBar from './components/NavigationBar';
import EarnPanel from './components/EarnPanel';
import InventoryPanel from './components/InventoryPanel';
import ShopPanel from './components/ShopPanel';

const API_BASE = 'http://localhost:3001/api';

// ==================== 年龄增长提醒弹窗 ====================
function AgeGrowthModal({ ageGrowth, onClose }) {
  if (!ageGrowth) return null;

  const { oldAge, newAge, newTitle, achievedTitle, achievedDesc, newlyUnlockedDresses } = ageGrowth;

  // 年龄对应的主题色
  const ageColors = {
    16: { from: '#E74C3C', to: '#C9A84C', bg: 'rgba(231,76,60,0.15)' },
    17: { from: '#8E44AD', to: '#E91E8C', bg: 'rgba(142,68,173,0.15)' },
    18: { from: '#C9A84C', to: '#FBBF24', bg: 'rgba(201,168,76,0.15)' },
  };
  const colors = ageColors[newAge] || { from: '#D4517A', to: '#C9A84C', bg: 'rgba(212,81,122,0.15)' };

  return (
    <div style={{
      position: 'fixed', inset: 0,
      background: 'rgba(5,2,5,0.88)',
      display: 'flex', alignItems: 'center', justifyContent: 'center',
      zIndex: 1000,
      backdropFilter: 'blur(8px)',
      animation: 'fadeIn 0.4s ease'
    }}>
      {/* 粒子光效装饰 */}
      <div style={{
        position: 'absolute', inset: 0, pointerEvents: 'none',
        background: `
          radial-gradient(ellipse at 20% 30%, ${colors.from}20 0%, transparent 50%),
          radial-gradient(ellipse at 80% 70%, ${colors.to}15 0%, transparent 50%)
        `
      }} />

      <div style={{
        background: 'linear-gradient(145deg, rgba(25,8,18,0.98), rgba(35,12,25,0.98))',
        border: `2px solid ${colors.from}60`,
        borderRadius: '28px',
        padding: '40px 36px',
        maxWidth: '480px',
        width: '90vw',
        position: 'relative',
        boxShadow: `0 24px 80px rgba(0,0,0,0.7), 0 0 60px ${colors.from}20`,
        animation: 'ageModalIn 0.5s cubic-bezier(.34,1.56,.64,1) both',
      }}>
        {/* 顶部光条 */}
        <div style={{
          position: 'absolute', top: 0, left: '15%', right: '15%', height: '3px',
          background: `linear-gradient(90deg, transparent, ${colors.from}, ${colors.to}, transparent)`,
          borderRadius: '0 0 4px 4px',
        }} />

        {/* 年龄徽标 */}
        <div style={{ textAlign: 'center', marginBottom: '28px' }}>
          <div style={{
            display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
            width: '100px', height: '100px', borderRadius: '50%',
            background: colors.bg,
            border: `3px solid ${colors.from}80`,
            boxShadow: `0 0 40px ${colors.from}30`,
            fontSize: '54px',
            animation: 'float 3s ease-in-out infinite',
            marginBottom: '16px',
          }}>
            🎂
          </div>
          <div style={{
            fontSize: '13px', color: colors.from, letterSpacing: '4px',
            fontWeight: '600', marginBottom: '8px', opacity: 0.8
          }}>
            ✦ 凌若雪的成长 ✦
          </div>
          <h2 style={{
            fontSize: '32px', fontWeight: '800', margin: '0 0 6px',
            background: `linear-gradient(135deg, ${colors.from}, ${colors.to})`,
            WebkitBackgroundClip: 'text', WebkitTextFillColor: 'transparent', backgroundClip: 'text',
            letterSpacing: '2px',
          }}>
            {oldAge}岁 → {newAge}岁
          </h2>
          <div style={{ fontSize: '16px', color: '#C9A84C', fontWeight: '600' }}>
            {newTitle}
          </div>
        </div>

        {/* 阶段称号 */}
        <div style={{
          background: colors.bg,
          border: `1px solid ${colors.from}40`,
          borderRadius: '16px', padding: '16px 20px', marginBottom: '22px',
          textAlign: 'center'
        }}>
          <div style={{ fontSize: '18px', fontWeight: '700', color: '#F5E6EC', marginBottom: '6px' }}>
            🏆 {achievedTitle}阶段圆满
          </div>
          <div style={{ fontSize: '13px', color: 'rgba(245,230,236,0.6)', lineHeight: '1.6' }}>
            {achievedDesc}
          </div>
        </div>

        {/* 新解锁服装 */}
        {newlyUnlockedDresses && newlyUnlockedDresses.length > 0 && (
          <div style={{ marginBottom: '24px' }}>
            <div style={{
              fontSize: '12px', color: '#C9A84C', letterSpacing: '2px',
              marginBottom: '12px', display: 'flex', alignItems: 'center', gap: '8px'
            }}>
              <div style={{ flex: 1, height: '1px', background: 'rgba(201,168,76,0.2)' }} />
              🎁 新解锁服装
              <div style={{ flex: 1, height: '1px', background: 'rgba(201,168,76,0.2)' }} />
            </div>
            <div style={{ display: 'flex', gap: '10px', flexWrap: 'wrap', justifyContent: 'center' }}>
              {newlyUnlockedDresses.map(dress => (
                <div key={dress.id} style={{
                  background: 'rgba(0,0,0,0.3)', borderRadius: '14px',
                  padding: '10px 14px', display: 'flex', alignItems: 'center', gap: '10px',
                  border: `1px solid ${colors.from}35`,
                }}>
                  {dress.image ? (
                    <img
                      src={dress.image} alt={dress.name}
                      onError={e => { e.target.style.display = 'none'; }}
                      style={{ width: '42px', height: '52px', objectFit: 'cover', borderRadius: '8px' }}
                    />
                  ) : (
                    <span style={{ fontSize: '32px' }}>{dress.emoji}</span>
                  )}
                  <div>
                    <div style={{ fontSize: '13px', fontWeight: '700', color: '#F4A0C0' }}>
                      {dress.name}
                    </div>
                    <div style={{ fontSize: '10px', color: '#C9A84C' }}>
                      {dress.subtitle}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* 按钮 */}
        <button
          onClick={onClose}
          style={{
            width: '100%', padding: '14px',
            background: `linear-gradient(135deg, ${colors.from}, ${colors.to}AA)`,
            border: 'none', borderRadius: '14px', color: 'white',
            cursor: 'pointer', fontFamily: 'inherit', fontSize: '16px',
            fontWeight: '700', letterSpacing: '2px',
            boxShadow: `0 6px 20px ${colors.from}40`,
            transition: 'all 0.2s ease',
          }}
          onMouseEnter={e => { e.currentTarget.style.transform = 'scale(1.02)'; }}
          onMouseLeave={e => { e.currentTarget.style.transform = 'scale(1)'; }}
        >
          ✨ 继续若雪的旅程
        </button>

        {/* CSS动画 */}
        <style>{`
          @keyframes ageModalIn {
            from { opacity: 0; transform: scale(0.8) translateY(30px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
          }
          @keyframes float {
            0%, 100% { transform: translateY(0); }
            50%       { transform: translateY(-8px); }
          }
          @keyframes fadeIn {
            from { opacity: 0; }
            to   { opacity: 1; }
          }
        `}</style>
      </div>
    </div>
  );
}

// ==================== 赠礼收入囊中弹窗 ====================
const rarityConfig = {
  common:    { label: '普通', color: '#9CA3AF', glow: 'rgba(156,163,175,0.3)' },
  uncommon:  { label: '精良', color: '#34D399', glow: 'rgba(52,211,153,0.4)' },
  rare:      { label: '稀有', color: '#60A5FA', glow: 'rgba(96,165,250,0.4)' },
  epic:      { label: '史诗', color: '#A78BFA', glow: 'rgba(167,139,250,0.4)' },
  legendary: { label: '传说', color: '#FBBF24', glow: 'rgba(251,191,36,0.5)' },
};

function ItemGiftModal({ item, onClose }) {
  if (!item) return null;
  const rarity = rarityConfig[item.rarity] || rarityConfig.common;

  return (
    <div style={{
      position: 'fixed', inset: 0,
      background: 'rgba(5,2,5,0.85)',
      display: 'flex', alignItems: 'center', justifyContent: 'center',
      zIndex: 1100,
      backdropFilter: 'blur(10px)',
      animation: 'giftOverlayIn 0.3s ease both',
    }}
      onClick={onClose}
    >
      {/* 粒子光效 */}
      <div style={{
        position: 'absolute', inset: 0, pointerEvents: 'none',
        background: `radial-gradient(ellipse at 50% 50%, ${rarity.glow} 0%, transparent 60%)`,
      }} />

      <div
        style={{
          background: 'linear-gradient(145deg, rgba(22,8,16,0.99), rgba(38,14,28,0.99))',
          border: `2px solid ${rarity.color}70`,
          borderRadius: '28px',
          padding: '36px 32px',
          maxWidth: '400px',
          width: '88vw',
          position: 'relative',
          boxShadow: `0 20px 80px rgba(0,0,0,0.75), 0 0 80px ${rarity.glow}`,
          animation: 'giftCardIn 0.45s cubic-bezier(.34,1.56,.64,1) both',
          textAlign: 'center',
        }}
        onClick={e => e.stopPropagation()}
      >
        {/* 顶部光条 */}
        <div style={{
          position: 'absolute', top: 0, left: '10%', right: '10%', height: '3px',
          background: `linear-gradient(90deg, transparent, ${rarity.color}, transparent)`,
          borderRadius: '0 0 4px 4px',
        }} />

        {/* 标题 */}
        <div style={{
          fontSize: '12px', color: rarity.color, letterSpacing: '4px',
          fontWeight: '700', marginBottom: '18px', opacity: 0.85,
        }}>
          ✦ 收入囊中 ✦
        </div>

        {/* 物品图标 */}
        <div style={{
          display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
          width: '90px', height: '90px', borderRadius: '22px',
          background: `radial-gradient(circle, ${rarity.glow} 0%, rgba(0,0,0,0.3) 100%)`,
          border: `2.5px solid ${rarity.color}80`,
          boxShadow: `0 0 30px ${rarity.glow}, inset 0 0 20px ${rarity.glow}`,
          fontSize: '46px',
          marginBottom: '16px',
          animation: 'giftIconFloat 2.5s ease-in-out infinite',
        }}>
          {item.emoji || '🎁'}
        </div>

        {/* 稀有度标签 */}
        <div style={{
          display: 'inline-block',
          background: `${rarity.color}22`,
          border: `1px solid ${rarity.color}60`,
          borderRadius: '20px',
          padding: '2px 14px',
          fontSize: '11px', color: rarity.color, fontWeight: '700',
          letterSpacing: '2px', marginBottom: '10px',
        }}>
          {rarity.label}
        </div>

        {/* 物品名 */}
        <h2 style={{
          fontSize: '26px', fontWeight: '800', margin: '0 0 8px',
          background: `linear-gradient(135deg, #F5E6EC, ${rarity.color})`,
          WebkitBackgroundClip: 'text', WebkitTextFillColor: 'transparent', backgroundClip: 'text',
          letterSpacing: '2px',
        }}>
          {item.name}
        </h2>

        {/* 分类 */}
        {item.category && (
          <div style={{
            fontSize: '11px', color: '#C9A84C', marginBottom: '12px',
            background: 'rgba(201,168,76,0.12)', borderRadius: '8px',
            padding: '2px 12px', display: 'inline-block',
            border: '1px solid rgba(201,168,76,0.25)',
          }}>
            {item.category}
          </div>
        )}

        {/* 描述 */}
        {item.description && (
          <div style={{
            fontSize: '13px', color: 'rgba(245,230,236,0.7)',
            lineHeight: '1.7', marginBottom: '16px',
            background: 'rgba(255,255,255,0.04)',
            borderRadius: '12px', padding: '10px 14px',
            border: '1px solid rgba(255,255,255,0.06)',
            fontStyle: 'italic',
          }}>
            {item.description}
          </div>
        )}

        {/* 属性加成 */}
        {item.effect && Object.keys(item.effect).length > 0 && (
          <div style={{
            display: 'flex', flexWrap: 'wrap', gap: '6px',
            justifyContent: 'center', marginBottom: '20px',
          }}>
            {Object.entries(item.effect).map(([key, val]) => (
              <span key={key} style={{
                fontSize: '12px', padding: '4px 12px', borderRadius: '10px',
                background: `${rarity.color}18`,
                color: rarity.color,
                border: `1px solid ${rarity.color}40`,
                fontWeight: '600',
              }}>
                ✦ {key} +{val}
              </span>
            ))}
          </div>
        )}

        {/* 底部提示文字 */}
        <div style={{
          fontSize: '13px', color: '#C9A84C',
          fontWeight: '600', letterSpacing: '1px',
          marginBottom: '20px',
          padding: '8px 0',
          borderTop: '1px solid rgba(201,168,76,0.15)',
          borderBottom: '1px solid rgba(201,168,76,0.15)',
        }}>
          🎁 【{item.name}】已收入囊中
        </div>

        {/* 确认按钮 */}
        <button
          onClick={onClose}
          style={{
            width: '100%', padding: '13px',
            background: `linear-gradient(135deg, ${rarity.color}CC, ${rarity.color}80)`,
            border: 'none', borderRadius: '14px', color: '#fff',
            cursor: 'pointer', fontFamily: 'inherit', fontSize: '15px',
            fontWeight: '700', letterSpacing: '2px',
            boxShadow: `0 6px 20px ${rarity.glow}`,
            transition: 'all 0.2s ease',
          }}
          onMouseEnter={e => { e.currentTarget.style.transform = 'scale(1.02)'; }}
          onMouseLeave={e => { e.currentTarget.style.transform = 'scale(1)'; }}
        >
          ✨ 收下了
        </button>

        {/* CSS 动画 */}
        <style>{`
          @keyframes giftOverlayIn {
            from { opacity: 0; }
            to   { opacity: 1; }
          }
          @keyframes giftCardIn {
            from { opacity: 0; transform: scale(0.75) translateY(40px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
          }
          @keyframes giftIconFloat {
            0%, 100% { transform: translateY(0) rotate(-3deg); }
            50%       { transform: translateY(-8px) rotate(3deg); }
          }
        `}</style>
      </div>
    </div>
  );
}

// ==================== 主应用 ====================
export default function App() {
  const [character, setCharacter] = useState(null);
  const [gameConfig, setGameConfig] = useState(null);
  const [currentScene, setCurrentScene] = useState('bedroom');
  const [sceneData, setSceneData] = useState(null);
  const [activeTab, setActiveTab] = useState('scene'); // scene | wardrobe | skills | log
  const [toast, setToast] = useState(null);
  const [loading, setLoading] = useState(true);
  const [courseResult, setCourseResult] = useState(null);

  // 年龄系统状态
  const [ageGrowthModal, setAgeGrowthModal] = useState(null); // 年龄增长弹窗数据
  const [ageStatus, setAgeStatus] = useState(null);           // 年龄进度状态
  const ageCheckTimerRef = useRef(null);

  // 物品赠送弹窗
  const [giftModal, setGiftModal] = useState(null); // { name, emoji, description, effect }

  // 显示提示
  const showToast = useCallback((message, type = 'success') => {
    setToast({ message, type, id: Date.now() });
    setTimeout(() => setToast(null), 3500);
  }, []);

  // 初始化游戏数据
  useEffect(() => {
    const initGame = async () => {
      try {
        const [charRes, configRes, ageRes] = await Promise.all([
          axios.get(`${API_BASE}/character`),
          axios.get(`${API_BASE}/game-config`),
          axios.get(`${API_BASE}/age-status`),
        ]);
        setCharacter(charRes.data.data);
        setGameConfig(configRes.data.data);
        setAgeStatus(ageRes.data.data);
        setLoading(false);
      } catch (err) {
        console.error('初始化失败:', err);
        showToast('连接服务器失败，请确认后端已启动（端口3001）', 'error');
        setLoading(false);
      }
    };
    initGame();
  }, [showToast]);

  // 定时轮询年龄状态（每15秒检测一次）
  useEffect(() => {
    if (!character) return;

    const checkAge = async () => {
      try {
        const res = await axios.post(`${API_BASE}/age/check`);
        const data = res.data.data;

        if (data.grew) {
          // 年龄增长！弹出提醒
          setCharacter(data.character);
          setAgeGrowthModal({
            oldAge: data.oldAge,
            newAge: data.newAge,
            newTitle: data.newTitle,
            achievedTitle: data.achievedTitle,
            achievedDesc: data.achievedDesc,
            newlyUnlockedDresses: data.newlyUnlockedDresses,
          });
          // 同步更新衣橱
          if (data.newlyUnlockedDresses?.length > 0) {
            setGameConfig(prev => {
              if (!prev) return prev;
              return {
                ...prev,
                wardrobe: {
                  ...prev.wardrobe,
                  dresses: prev.wardrobe.dresses.map(d => {
                    const unlocked = data.newlyUnlockedDresses.find(u => u.id === d.id);
                    return unlocked ? { ...d, unlocked: true } : d;
                  })
                }
              };
            });
          }
        }

        // 更新年龄状态（进度条用）
        const ageRes = await axios.get(`${API_BASE}/age-status`);
        setAgeStatus(ageRes.data.data);
      } catch (err) {
        // 静默处理轮询错误
      }
    };

    ageCheckTimerRef.current = setInterval(checkAge, 15000);
    return () => clearInterval(ageCheckTimerRef.current);
  }, [character]);

  // 加载场景数据
  useEffect(() => {
    if (!character) return;
    const loadScene = async () => {
      try {
        const res = await axios.get(`${API_BASE}/scene/${currentScene}`);
        setSceneData(res.data.data);
      } catch (err) {
        if (err.response?.status === 403) {
          showToast(err.response.data.message, 'warning');
          setCurrentScene('bedroom');
        }
      }
    };
    loadScene();
  }, [currentScene, character, showToast]);

  // 换装
  const handleChangeDress = async (dressId) => {
    try {
      const res = await axios.post(`${API_BASE}/character/change-dress`, { dressId });
      setCharacter(res.data.data);
      showToast(res.data.message);
    } catch (err) {
      showToast(err.response?.data?.message || '换装失败', 'error');
    }
  };

  // 换配饰
  const handleChangeAccessory = async (accessoryId) => {
    try {
      const res = await axios.post(`${API_BASE}/character/change-accessory`, { accessoryId });
      setCharacter(res.data.data);
      showToast(res.data.message);
    } catch (err) {
      showToast(err.response?.data?.message || '换装失败', 'error');
    }
  };

  // 解锁物品
  const handleUnlockItem = async (itemId, itemType) => {
    try {
      const res = await axios.post(`${API_BASE}/wardrobe/unlock`, { itemId, itemType });
      setCharacter(res.data.data.character);
      setGameConfig(prev => {
        const newConfig = { ...prev };
        if (itemType === 'dress') {
          newConfig.wardrobe = {
            ...newConfig.wardrobe,
            dresses: newConfig.wardrobe.dresses.map(d =>
              d.id === itemId ? { ...d, unlocked: true } : d
            )
          };
        } else if (itemType === 'accessory') {
          newConfig.wardrobe = {
            ...newConfig.wardrobe,
            accessories: newConfig.wardrobe.accessories.map(a =>
              a.id === itemId ? { ...a, unlocked: true } : a
            )
          };
        }
        return newConfig;
      });
      showToast(res.data.message, 'success');
    } catch (err) {
      showToast(err.response?.data?.message || '购买失败', 'error');
    }
  };

  // 参加课程（包含年龄增长检测）
  const handleAttendCourse = async (courseId) => {
    try {
      const res = await axios.post(`${API_BASE}/course/attend`, { courseId });
      const { character: newChar, ageGrowth } = res.data.data;
      setCharacter(newChar);
      setCourseResult(res.data.data);
      showToast(res.data.message, 'success');

      // 检查是否触发年龄增长
      if (ageGrowth) {
        setAgeGrowthModal({
          oldAge: ageGrowth.oldAge,
          newAge: ageGrowth.newAge,
          newTitle: ageGrowth.title || gameConfig?.ageConfig?.ageTitles?.[ageGrowth.newAge],
          achievedTitle: ageGrowth.achievedTitle,
          achievedDesc: ageGrowth.achievedDesc,
          newlyUnlockedDresses: ageGrowth.newlyUnlockedDresses,
        });
        // 同步衣橱
        if (ageGrowth.newlyUnlockedDresses?.length > 0) {
          setGameConfig(prev => prev ? {
            ...prev,
            wardrobe: {
              ...prev.wardrobe,
              dresses: prev.wardrobe.dresses.map(d => {
                const unlocked = ageGrowth.newlyUnlockedDresses.find(u => u.id === d.id);
                return unlocked ? { ...d, unlocked: true } : d;
              })
            }
          } : prev);
        }
        // 更新年龄进度
        try {
          const ageRes = await axios.get(`${API_BASE}/age-status`);
          setAgeStatus(ageRes.data.data);
        } catch (_) {}
      }
    } catch (err) {
      showToast(err.response?.data?.message || '课程参加失败', 'error');
    }
  };

  // 与NPC普通对话
  const handleTalkToNpc = async (npcId) => {
    try {
      const res = await axios.post(`${API_BASE}/npc/talk`, { npcId });
      setCharacter(res.data.data.character);
      const { npc, dialogue, reward } = res.data.data;
      let msg = `${npc.emoji} ${npc.name}："${dialogue}"`;
      if (reward?.gold) msg += ` 💰 +${reward.gold}金币！`;
      showToast(msg, 'dialogue');
    } catch (err) {
      showToast('对话失败', 'error');
    }
  };

  // NPC 选项对话处理（由 SceneView 调用）
  const handleNpcChoice = async (npcId, choiceId) => {
    try {
      const res = await axios.post(`${API_BASE}/npc/choice`, { npcId, choiceId });
      setCharacter(res.data.data.character);
      return res.data.data; // 返回 consequence 数据给 SceneView
    } catch (err) {
      showToast(err.response?.data?.message || '选择失败', 'error');
      return null;
    }
  };

  // 购买商店道具
  const handleBuyShopItem = async (itemId) => {
    try {
      const res = await axios.post(`${API_BASE}/shop/buy`, { itemId });
      setCharacter(res.data.data.character);
      showToast(res.data.message, 'success');
      // 检查年龄增长
      if (res.data.data.ageGrowth) {
        const ag = res.data.data.ageGrowth;
        setAgeGrowthModal({
          oldAge: ag.oldAge, newAge: ag.newAge,
          newTitle: ag.title || gameConfig?.ageConfig?.ageTitles?.[ag.newAge],
          achievedTitle: ag.achievedTitle, achievedDesc: ag.achievedDesc,
          newlyUnlockedDresses: ag.newlyUnlockedDresses,
        });
      }
    } catch (err) {
      showToast(err.response?.data?.message || '购买失败', 'error');
    }
  };

  // 接收赠礼（NPC对话触发）
  const handleItemGift = (giftItem) => {
    // 把物品加入背包（更新character状态）
    setCharacter(prev => {
      if (!prev) return prev;
      const inventory = prev.inventory ? [...prev.inventory] : [];
      inventory.push({
        id: `gift_${Date.now()}`,
        itemId: giftItem.id || giftItem.name,
        name: giftItem.name,
        emoji: giftItem.emoji || '🎁',
        category: giftItem.category || '礼物',
        description: giftItem.description || '',
        effect: giftItem.effect || {},
        rarity: giftItem.rarity || 'common',
        source: 'gift',
        acquiredAt: new Date().toISOString(),
      });
      return { ...prev, inventory };
    });
    // 弹出收入囊中提示
    setGiftModal(giftItem);
  };

  // 切换场景
  const handleSceneChange = (sceneId) => {
    setCurrentScene(sceneId);
    setCourseResult(null);
    setActiveTab('scene');
  };

  // 每日奖励
  const handleDailyReward = async () => {
    try {
      const res = await axios.post(`${API_BASE}/daily-reward`);
      setCharacter(res.data.data);
      showToast('🎁 ' + res.data.message, 'success');
    } catch (err) {
      showToast('领取失败', 'error');
    }
  };

  // 重置游戏
  const handleResetGame = async () => {
    if (!window.confirm('确定要重置游戏吗？所有进度将会丢失！')) return;
    try {
      const res = await axios.post(`${API_BASE}/character/reset`);
      setCharacter(res.data.data);
      setCourseResult(null);
      setCurrentScene('bedroom');
      setAgeGrowthModal(null);
      // 重新获取配置（衣橱解锁状态重置）
      const [configRes, ageRes] = await Promise.all([
        axios.get(`${API_BASE}/game-config`),
        axios.get(`${API_BASE}/age-status`),
      ]);
      setGameConfig(configRes.data.data);
      setAgeStatus(ageRes.data.data);
      showToast(res.data.message, 'success');
    } catch (err) {
      showToast('重置失败', 'error');
    }
  };

  if (loading) return <LoadingScreen />;

  if (!character || !gameConfig) {
    return (
      <div style={{
        display: 'flex', justifyContent: 'center', alignItems: 'center',
        height: '100vh', flexDirection: 'column', gap: '20px',
        background: 'linear-gradient(135deg, #1a0a0f, #2d1520)'
      }}>
        <div style={{ fontSize: '60px' }}>🏯</div>
        <div style={{ color: '#F4A0C0', fontSize: '18px' }}>无法连接到游戏服务器</div>
        <div style={{ color: 'rgba(245,230,236,0.5)', fontSize: '14px' }}>请确认后端服务已启动（端口3001）</div>
        <button className="btn-primary" onClick={() => window.location.reload()}>重新连接</button>
      </div>
    );
  }

  // Tab 配置（复用）
  return (
    <div style={{
      minHeight: '100vh',
      background: 'linear-gradient(135deg, #1a0a0f 0%, #2d1520 50%, #1a0a0f 100%)',
      position: 'relative',
      overflow: 'hidden'
    }}>
      {/* 背景装饰 */}
      <div style={{
        position: 'fixed', inset: 0, pointerEvents: 'none', zIndex: 0,
        background: `
          radial-gradient(ellipse at 10% 20%, rgba(212,81,122,0.08) 0%, transparent 40%),
          radial-gradient(ellipse at 90% 80%, rgba(201,168,76,0.06) 0%, transparent 40%),
          radial-gradient(ellipse at 50% 50%, rgba(100,20,50,0.15) 0%, transparent 70%)
        `
      }} />

      {/* 顶部状态栏 */}
      <TopBar
        character={character}
        onDailyReward={handleDailyReward}
        onReset={handleResetGame}
      />

      }}>
        <div style={{
          display: 'grid',
          gridTemplateColumns: '280px 1fr 260px',
          gap: '16px',
          alignItems: 'start'
        }}>
          {/* 左侧：角色面板 */}
          <div style={{ position: 'sticky', top: '90px' }}>
            <CharacterPanel
              character={character}
              gameConfig={gameConfig}
              currentScene={currentScene}
              ageStatus={ageStatus}
            />
          </div>

          {/* 中间：主内容区 */}
          <div>
            {/* Tab导航 */}
            <div style={{
              display: 'flex', gap: '4px', marginBottom: '16px',
              background: 'rgba(40,15,25,0.6)', borderRadius: '12px', padding: '4px',
              border: '1px solid rgba(212,81,122,0.2)'
            }}>
              {[
                { id: 'scene',     label: '🏯 游历' },
                { id: 'wardrobe',  label: '👗 衣橱' },
                { id: 'shop',      label: '🏪 商店' },
                { id: 'inventory', label: '🎒 装备' },
                { id: 'earn',      label: '🪙 赚钱' },
                { id: 'skills',    label: '✨ 技能' },
                { id: 'log',       label: '📜 日记' }
              ].map(tab => (
                <button
                  key={tab.id}
                  onClick={() => setActiveTab(tab.id)}
                  style={{
                    flex: 1, padding: '10px', border: 'none', borderRadius: '8px',
                    cursor: 'pointer', fontFamily: 'inherit', fontSize: '14px',
                    fontWeight: '600', letterSpacing: '1px', transition: 'all 0.3s ease',
                    background: activeTab === tab.id
                      ? 'linear-gradient(135deg, #D4517A, #A03058)'
                      : 'transparent',
                    color: activeTab === tab.id ? 'white' : 'rgba(245,230,236,0.6)',
                    boxShadow: activeTab === tab.id ? '0 4px 12px rgba(212,81,122,0.3)' : 'none'
                  }}
                >
                  {tab.label}
                </button>
              ))}
            </div>

            {/* 内容区 */}
            {activeTab === 'scene' && sceneData && (
              <SceneView
                sceneData={sceneData}
                scenes={gameConfig.scenes}
                character={character}
                wardrobe={gameConfig.wardrobe}
                courseResult={courseResult}
                skillConfig={gameConfig.skillConfig}
                shopItems={gameConfig.shopItems || []}
                onAttendCourse={handleAttendCourse}
                onTalkToNpc={handleTalkToNpc}
                onNpcChoice={handleNpcChoice}
                onSceneChange={handleSceneChange}
                onBuyItem={handleBuyShopItem}
                onItemGift={handleItemGift}
                currentScene={currentScene}
              />
            )}
            {activeTab === 'shop' && (
              <ShopPanel
                shopItems={gameConfig.shopItems || []}
                character={character}
                skillConfig={gameConfig.skillConfig}
                onBuyItem={handleBuyShopItem}
              />
            )}
            {activeTab === 'wardrobe' && (
              <WardrobePanel
                wardrobe={gameConfig.wardrobe}
                character={character}
                onChangeDress={handleChangeDress}
                onChangeAccessory={handleChangeAccessory}
                onUnlockItem={handleUnlockItem}
              />
            )}
            {activeTab === 'inventory' && (
              <InventoryPanel
                inventory={character?.inventory || []}
                skillConfig={gameConfig.skillConfig}
              />
            )}
            {activeTab === 'earn' && (
              <EarnPanel
                character={character}
                earnActivities={gameConfig.earnActivities || []}
                onCharacterUpdate={setCharacter}
                showToast={showToast}
              />
            )}
            {activeTab === 'skills' && (
              <SkillsPanel
                character={character}
                skillConfig={gameConfig.skillConfig}
                courses={gameConfig.courses}
              />
            )}
            {activeTab === 'log' && (
              <ActivityLog apiBase={API_BASE} />
            )}
          </div>

          {/* 右侧：场景导航 */}
          <div style={{ position: 'sticky', top: '90px' }}>
            <NavigationBar
              scenes={gameConfig.scenes}
              currentScene={currentScene}
              character={character}
              onSceneChange={handleSceneChange}
              activeTab={activeTab}
              onTabChange={setActiveTab}
            />
          </div>
        </div>
      </div>

      {/* 底部装饰 */}
      <div style={{
        position: 'fixed', bottom: 0, left: 0, right: 0, height: '3px',
        background: 'linear-gradient(90deg, transparent, #D4517A, #C9A84C, #D4517A, transparent)',
        zIndex: 100
      }} />

      {/* Toast提示 */}
      {toast && <Toast message={toast.message} type={toast.type} onClose={() => setToast(null)} />}

      {/* 年龄增长弹窗 */}
      {ageGrowthModal && (
        <AgeGrowthModal
          ageGrowth={ageGrowthModal}
          onClose={() => setAgeGrowthModal(null)}
        />
      )}

      {/* 赠礼收入囊中弹窗 */}
      {giftModal && (
        <ItemGiftModal
          item={giftModal}
          onClose={() => setGiftModal(null)}
        />
      )}
    </div>
  );
}

